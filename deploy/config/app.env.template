# Laytekz app server (apps/server) environment.
#
# setup.sh renders this template into ~/galley-server/config/app.env (mode
# 600) and appends ALDINE_SIGNING_SECRET and COMPILER_TOKEN, each generated
# once on the server and kept on every later run (COMPILER_TOKEN is the same line
# as in compiler.env: the secret the app sends to the compiler). Do not edit the rendered file: setup.sh rewrites it. Put
# local additions or overrides in ~/galley-server/config/app.local.env (same
# KEY=VALUE format, loaded last by run-app.sh).
#
# Plain KEY=VALUE lines only (no quotes, no spaces around "="): run-app.sh
# loads this file with bash. Every choice is explained in deploy/README.md,
# "Configuration reference".
#
# NOT in this file: the Google OAuth client id and secret. run-app.sh loads
# them from GALLEY_GOOGLE_ENV (~/galley-server/secrets/google-oauth.env).
# WEB_DIST, TEMPLATES_DIR and PLUGINS_DIR are not here either: run-app.sh
# points them into the code tree it starts from (app-a or app-b).

# ---- network: loopback only; Cloudflare Tunnel is the only way in
HOST=127.0.0.1
PORT=@APP_PORT@
TRUST_PROXY=1
ALDINE_PUBLIC_URL=@PUBLIC_URL@
COOKIE_SECURE=1
COMPILER_URL=http://127.0.0.1:@COMPILER_PORT@
# A typeset request is answered within 90 s, waiting for the branch's previous
# typesets included, so the answer reaches the browser before Cloudflare's
# ~100 s limit turns it into an error page. Past it the typeset is stopped and
# reported as timed out.
COMPILE_DEADLINE_MS=90000

# ---- accounts: Google sign-in only, new accounts wait for an administrator
AUTH_ENABLED=1
ALDINE_SSO_ONLY=1
ALDINE_SIGNUP=approval
ALDINE_ADMIN_EMAILS=@ADMIN_EMAILS@
ALDINE_OAUTH_REGISTRATION=closed
ALDINE_PERSONAL_TEMPLATE_REPOS=0
# No ALDINE_INSTANCE_NAME: the product name (Laytekz) is built into the code,
# and an operator name set here would appear after it ("Laytekz · <name>").

# ---- agents: lets the desktop console's Claude Code / Codex buttons reach a
# project through the built-in tool endpoint. Client registration stays closed
# (ALDINE_OAUTH_REGISTRATION above), so only tokens made in Account settings work.
ALDINE_MCP=1

# ---- the pet: the server ships a default one (apps/server/assets/pet). To use
# another image (a still PNG/WebP/SVG up to 512 KB), set its path here; set
# ALDINE_INSTANCE_PET=none for no pet at all.
# ALDINE_INSTANCE_PET=@ROOT@/assets/pet/pet.png
# ALDINE_INSTANCE_PET_SILHOUETTE=@ROOT@/assets/pet/pet-silhouette.png

# ---- storage: absolute, outside the code tree, all under ~/galley-server
DATA_DIR=@ROOT@/data
META_DIR=@ROOT@/meta
CACHE_DIR=@ROOT@/cache

# ---- AGPL source offer (read by the fork's source-offer patch, galley-source.ts)
GALLEY_SOURCE_URL=@PUBLIC_URL@/source.tar.gz
GALLEY_SOURCE_TARBALL=@ROOT@/source/galley-source.tar.gz

# ---- where run-app.sh finds the Google credentials
GALLEY_GOOGLE_ENV=@ROOT@/secrets/google-oauth.env

# ---- where the sign-in card and /about link the desktop app (https only;
# leave unset to hide the link)
GALLEY_DESKTOP_URL=https://github.com/Computational-Memory-Lab/laytekz/releases/latest

LOG_LEVEL=info
