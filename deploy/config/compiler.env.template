# Laytekz compiler (apps/compiler) environment.
#
# setup.sh renders this template into ~/galley-server/config/compiler.env
# (mode 600). run-compiler.sh starts the compiler with ONLY the variables
# below (an emptied environment), so nothing from PM2's or a login shell's
# environment reaches it. The compiler runs untrusted LaTeX: NEVER add a
# secret here. run-compiler.sh refuses to start if a variable name looks like
# one.
#
# The single exception is COMPILER_TOKEN, which setup.sh (or deploy.sh, when
# it is missing) appends at the end: the shared secret the app must send in
# the x-compiler-token header. The compiler refuses to start on 127.0.0.1
# without it, removes it from its own environment before it starts any tool,
# and galley-sandbox drops it again for every TeX run. app.env holds the same
# line. To rotate it: ./setup.sh --rotate-compiler-token.
#
# Plain KEY=VALUE lines only; values are exported verbatim.

# ---- service
HOST=127.0.0.1
PORT=@COMPILER_PORT@
DATA_DIR=@ROOT@/data
# One latexmk run may last at most 85 s: Cloudflare gives up on a request
# after about 100 s and shows its own error page instead of the app's answer.
# The app's COMPILE_DEADLINE_MS (app.env) bounds the whole request, waiting
# included, and the compiler honours the time the app has left.
COMPILE_TIMEOUT_MS=85000
MAX_CONCURRENT_COMPILES=3
ALDINE_PREAMBLE_CACHE=1
# Thumbnails need a PDF rasterizer (Ghostscript or poppler) that parses PDFs
# users influence, so it should be one the system's package manager keeps
# updated, not a copy under the home directory. 0 = no project-list
# thumbnails; typesetting is unaffected. Set 1 only if the server has one.
ALDINE_THUMBNAILS=0
TEXLIVE_SCHEME_FILE=@BIN@/config/texlive-scheme

# ---- a private HOME and scrubbed PATH (shims first: they sandbox each tool)
HOME=@ROOT@/compiler-home
TMPDIR=@ROOT@/compiler-home/tmp
XDG_CONFIG_HOME=@ROOT@/compiler-home/.config
XDG_CACHE_HOME=@ROOT@/compiler-home/.cache
PAR_GLOBAL_TMPDIR=@ROOT@/compiler-home/par
LANG=C.UTF-8
PATH=@BIN@/libexec/shims:@TEXBIN@:/usr/bin:/bin

# ---- TeX security switches (environment beats every texmf.cnf)
TEXMFCNF=@BIN@/config/texmf:
openin_any=p
openout_any=p
shell_escape=p

# ---- galley-sandbox (Landlock + seccomp); see libexec/galley-sandbox.py
GALLEY_SANDBOX_REQUIRE=1
GALLEY_TEXBIN=@TEXBIN@
GALLEY_SHIMS=@BIN@/libexec/shims
GALLEY_TMP_ROOT=@ROOT@/compiler-home/tmp
# layer 1 (the compiler process): read-only and read-write trees
GALLEY_SANDBOX_RO=@TEXLIVE@:@BIN@:@ROOT@/opt
GALLEY_SANDBOX_RW=@ROOT@/data:@ROOT@/compiler-home
# layer 2 (one TeX run): read-only trees besides the system and its project
GALLEY_SANDBOX_TOOL_RO=@TEXLIVE@:@BIN@:@ROOT@/opt:@ROOT@/compiler-home/.config:@ROOT@/compiler-home/.cache:@ROOT@/compiler-home/par:@ROOT@/compiler-home/texmf:@ROOT@/compiler-home/texmf-var:@ROOT@/compiler-home/texmf-config
GALLEY_TOOL_MAX_AS_GIB=8
GALLEY_TOOL_MAX_FILE_GIB=1
GALLEY_TOOL_NICE=5
# luaotfload's font-name index, built by warm-caches.sh, read-only to TeX runs
GALLEY_LUAOTFLOAD_NAMES=@ROOT@/compiler-home/texmf-var/luatex-cache/generic/names
# Perl modules latexindent needs (YAML::Tiny, File::HomeDir), set for latexindent runs only
GALLEY_LATEXINDENT_PERL5LIB=@ROOT@/opt/perl5
