# Settings for one installation. Copy this file to site.env (which git ignores)
# and fill it in. Plain KEY=value lines; a variable already set in your
# environment wins over this file.

# How you reach the server over SSH: a host name, or an alias from ~/.ssh/config.
GALLEY_SSH_HOST=your-server

# The public address people open in a browser. No trailing slash.
GALLEY_PUBLIC_URL=https://latex.example.com

