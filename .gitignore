# The server is a separate repository (laytekz-server). Clone it into ./server.
/server/

# Dependencies and build output
node_modules/
desktop/dist/
desktop/release/
desktop/test-results/
desktop/playwright-report/
# Screenshots and logs from end-to-end runs: they record local paths
desktop/tests/e2e-collab/evidence/
builder-debug.yml
builder-effective-config.yaml
*.blockmap

# Deployment-specific material that must never be published
private-assets/
site.env
.env
.env.*
*.env
!*.env.template
!*.env.example
secrets/
.secrets*/
.data*/
cloudflared/
.cloudflared/
*.pem
*.key
*.p12
*.pfx
*credentials*.json
admin-email*
*.db
*.db-wal
*.db-shm
*.sqlite*
*.log
logs/
backups*/
galley-*.tar.gz
laytekz-*.tar.gz
*.tar.gz.partial

# Private notes and local tooling state
*.local.md
.claude/

# The compile-sandbox experiment: not used by the deployment (which runs
# deploy/libexec/galley-sandbox.py) and not reviewed for release yet.
/sandbox/

# Working copies used during development
/server-v2/
/desktop-v2/

# OS and editor files
.DS_Store
Thumbs.db
*.swp

